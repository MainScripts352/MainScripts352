---Looping Time Stop Operator
local TimeStopLoopOperator = false
game:GetService("RunService").RenderStepped:Connect(function()
if time_stopped == true and TimeStopLoopOperator == false then
   TimeStopLoopOperator = true
   pcall(function()
   game:GetService("Lighting").ClockTime = clock_time
   for i, v in pairs(workspace:GetDescendants()) do
     if v:IsA("BasePart") and v.Anchored == false and not string.find(v:GetFullName(), game.Players.LocalPlayer.Name)  then
        v.Anchored = true
        if freezed_everything == false then
           table.insert(anchored_parts, v)
        end
     end
   end
   end)
   freezed_everything = true
   TimeStopLoopOperator = false
end
end)
